{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "api/*.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/*.go",
      "use": "@vercel/go"
    }
  ],
  "rewrites": [
    {
      "source": "/api/extract",
      "destination": "/api/extract.py"
    },
    {
      "source": "/api/supported-sites",
      "destination": "/api/extract.py"
    },
    {
      "source": "/api/history",
      "destination": "/api/extract.py"
    },
    {
      "source": "/api/history/(.*)",
      "destination": "/api/extract.py"
    },
    {
      "source": "/api/proxy-stream",
      "destination": "/api/extract.py"
    },
    {
      "source": "/api/download/(.*)",
      "destination": "/api/extract.py"
    },
    {
      "source": "/api/py/(.*)",
      "destination": "/api/extract.py"
    },
    {
      "source": "/api/go/(.*)",
      "destination": "/api/security.go"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
